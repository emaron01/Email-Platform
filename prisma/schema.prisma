generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum EmailLength {
  SHORT
  MEDIUM
  LONG
}

enum CampaignContactStatus {
  PENDING
  SELECTED
  EXCLUDED
  COMPLETED
}

enum EmailDraftStatus {
  NOT_CREATED
  DRAFT
  APPROVED
  SENDING
  SENT
  SKIPPED
}

enum EmailDraftSource {
  AI
  MANUAL
}

enum EmailDraftKind {
  INITIAL
  FOLLOW_UP
  REPLY
}

enum ReplyClassification {
  INTERESTED
  OBJECTION
  REFERRAL
  NOT_NOW
  NOT_INTERESTED
}

enum EmailSentMethod {
  MANUAL_ASSERTION
  CONNECTED_PROVIDER
}

enum EmailSendRecordMethod {
  DEEPLINK_INTENT
  MICROSOFT_GRAPH
}

enum MailboxProvider {
  MICROSOFT_365
}

enum MailboxConnectionStatus {
  CONNECTED
  RECONNECT_REQUIRED
}

enum ContactListSource {
  PASTE
  UPLOAD
}

enum ScoringRunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
}

enum TitleSuggestionStatus {
  PENDING
  APPROVED
  DISMISSED
}

enum ContactScoringStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ScoreLabel {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DISQUALIFIED
}

enum QualificationBucket {
  GOOD
  NEEDS_REVIEW
  POOR_FIT
  EXCLUDED
}

enum QualificationOverrideTarget {
  COMPANY
  CONTACT
}

enum ResearchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  NOT_REQUIRED
}

enum CompanyResearchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

enum ResearchConfidence {
  HIGH
  MEDIUM
  LOW
}

enum ResearchMethod {
  AUTOMATED
  MANUAL
  HYBRID
}

enum UsageCategory {
  RESEARCH
  CONTACT_RESEARCH
  INTERPRETATION
  SCORING
  EMAIL_GENERATION
  PRODUCT_RESEARCH
  PERSONA_RESEARCH
}

enum UsageOperation {
  WEB_SEARCH
  RESEARCH_SYNTHESIS
  CONTACT_RESEARCH_SYNTHESIS
  ICP_INTERPRETATION
  PERSONA_INTERPRETATION
  CONTACT_SCORING
  EMAIL_GENERATION
  PRODUCT_URL_RETRIEVAL
  PRODUCT_WEB_SEARCH
  PRODUCT_DOCUMENT_EXTRACTION
  PRODUCT_SYNTHESIS
  PRODUCT_SOURCE_INGEST
  PERSONA_SOURCE_INGEST
  PERSONA_WEB_SEARCH
  PERSONA_SYNTHESIS
  PERSONA_URL_RETRIEVAL
  VOICE_SAMPLE_SAVED
  EMAIL_DRAFT_CREATED
  CAMPAIGN_OFFER_VALIDATED
  EMAIL_DRAFT_SENT
  EMAIL_REPLY_CLASSIFIED
  EMAIL_DEEPLINK_OPENED
  TITLE_SUGGESTION
}

enum CriterionDataType {
  TEXT
  NUMBER
  CURRENCY
  BOOLEAN
  ENUM
  MULTI_SELECT
  DATE
}

enum CriterionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  IN
  NOT_IN
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  BETWEEN
  EXISTS
  NOT_EXISTS
}

enum CriterionImportance {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum CriterionSource {
  AI_INTERPRETED
  MANUAL
  MIGRATED_FROM_LEGACY
}

/// Whether a persona exclusion can be decided from title alone or needs researched evidence.
enum ExclusionTestability {
  TITLE_TESTABLE
  EVIDENCE_TESTABLE
}

/// Where evidence for an ICP criterion is expected to come from.
enum CriterionEvidenceClass {
  LIST_DATA
  COMPANY_RESEARCH
  TARGETED_SEARCH
  SEMANTIC
}

/// Whether an ICP criterion defines a fit (PRIMARY) or is only an upside signal (SECONDARY).
enum IcpCriterionTier {
  PRIMARY
  SECONDARY
}

/// User decision for TARGETED_SEARCH criteria before they are considered approved.
enum TargetedSearchDecision {
  /// Confirm when found; never penalize when not found (recommended).
  KEEP_ASYMMETRIC
  MAKE_SUPPORTING
  REMOVE
}

enum ContactResearchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
  NOT_REQUIRED
}

enum UsageEventStatus {
  SUCCESS
  PARTIAL
  FAILED
  RETRY
}

enum UsageResource {
  EMAIL_GENERATION
  EMAIL_SEND
  ACTIVE_RESEARCHED_COMPANY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlatformRole {
  NONE
  SUPER_ADMIN
  SUPPORT
}

enum AdminAuditAction {
  USER_SIGNUP
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET_COMPLETED
  ORGANIZATION_INVITATION_CREATED
  ORGANIZATION_INVITATION_ACCEPTED
  ORGANIZATION_MEMBER_ROLE_CHANGED
  BILLING_CONTACT_CHANGED
  TRANSACTIONAL_TEMPLATE_CHANGED
  PLATFORM_ROLE_CHANGED
  PLATFORM_SUPER_ADMIN_PROVISIONED
  WORKSPACE_RENAMED
  LOGIN_SUCCEEDED
  LOGOUT
  ICP_INTERPRETED
  ICP_CRITERION_CHANGED
  PERSONA_INTERPRETED
  PERSONA_CRITERION_CHANGED
}

enum TransactionalEmailTemplateKey {
  EMAIL_VERIFICATION
  WELCOME
  PASSWORD_RESET
  PASSWORD_CHANGED
  ORGANIZATION_INVITATION
  INVITATION_ACCEPTED
}

enum TransactionalEmailStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
  BOUNCED
  COMPLAINED
}

enum ProductSourceType {
  URL
  PASTED_TEXT
  UPLOADED_DOCUMENT
  USER_NOTE
}

/// How a voice sample was captured. PASTED now; imported later.
enum VoiceSampleProvenance {
  PASTED
  IMPORTED
}

enum ProductSourceStatus {
  PENDING
  ACQUIRED
  EXTRACTED
  FAILED
  DUPLICATE
  ARCHIVED
}

enum ProductSetupStatus {
  NOT_STARTED
  ACQUIRING
  SYNTHESIZING
  NEEDS_REVIEW
  APPROVED
  PARTIAL
  FAILED
}

enum ProductApprovalStatus {
  NOT_STARTED
  DRAFT
  NEEDS_REVIEW
  APPROVED
  SUPERSEDED
}

enum PersonaSetupStatus {
  NOT_STARTED
  RESEARCHING
  SYNTHESIZING
  NEEDS_REVIEW
  APPROVED
  PARTIAL
  FAILED
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  /// IANA timezone for daily quota windows (e.g. America/New_York).
  timezone  String             @default("UTC")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships              OrganizationMembership[]
  products                 Product[]
  offers                   Offer[]
  icps                     Icp[]
  personas                 Persona[]
  contactLists             ContactList[]
  contacts                 Contact[]
  companies                Company[]
  companyResearch          CompanyResearch[]
  contactResearch          ContactResearch[]
  icpCriteria              IcpCriterion[]
  personaCriteria          PersonaCriterion[]
  contactScores            ContactScore[]
  scoringRuns              ScoringRun[]
  titleSuggestions         TitleSuggestion[]
  productTitleDismissals   ProductTitleDismissal[]
  campaigns                Campaign[]
  campaignPersonas         CampaignPersona[]
  campaignContacts         CampaignContact[]
  emailDrafts              EmailDraft[]
  usagePolicy              OrganizationUsagePolicy?
  researchPolicy           ResearchPolicy?
  userUsageOverrides       UserUsageOverride[]
  usageEvents              UsageEvent[]
  usageQuotaLedgers        UsageQuotaLedger[]
  qualificationOverrides   QualificationBucketOverride[]
  invitations              OrganizationInvitation[]
  billingProfile           OrganizationBillingProfile?
  transactionalEmailEvents TransactionalEmailEvent[]
  activeForUsers           User[]                        @relation("ActiveOrganization")
  productSources           ProductSource[]
  productSourceBlobs       ProductSourceBlob[]
  productEvidenceBundles   ProductEvidenceBundle[]
  productSetupRuns         ProductSetupRun[]
  personaSources           PersonaSource[]
  personaEvidenceBundles   PersonaEvidenceBundle[]
  personaSetupRuns         PersonaSetupRun[]
  voiceSamples             VoiceSample[]
  mailboxConnections       MailboxConnection[]
  mailboxOAuthStates       MailboxOAuthState[]
  emailSendRecords         EmailSendRecord[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id                   String       @id @default(cuid())
  authUserId           String?      @unique
  email                String       @unique
  emailNormalized      String       @unique
  firstName            String?
  lastName             String?
  name                 String?
  emailVerifiedAt      DateTime?
  platformRole         PlatformRole @default(NONE)
  activeOrganizationId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  activeOrganization       Organization?                 @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  memberships              OrganizationMembership[]
  usageOverrides           UserUsageOverride[]
  usageEvents              UsageEvent[]
  usageQuotaLedgers        UsageQuotaLedger[]
  qualificationOverrides   QualificationBucketOverride[]
  invitationsSent          OrganizationInvitation[]      @relation("InvitedBy")
  companyResearchInitiated CompanyResearch[]             @relation("ResearchInitiatedBy")
  adminAuditEvents         AdminAuditEvent[]
  transactionalEmailEvents TransactionalEmailEvent[]
  voiceSamples             VoiceSample[]
  sentEmailDrafts          EmailDraft[]                  @relation("EmailDraftSentBy")
  mailboxConnections       MailboxConnection[]
  mailboxOAuthStates       MailboxOAuthState[]
  emailSendRecords         EmailSendRecord[]
  titleSuggestionsResolved TitleSuggestion[]             @relation("TitleSuggestionResolvedBy")
  productTitleDismissals   ProductTitleDismissal[]       @relation("ProductTitleDismissedBy")

  @@index([platformRole])
  @@index([activeOrganizationId])
}

/// Pasted writing samples for one user inside one organization. Never org-wide.
model VoiceSample {
  id             String                @id @default(cuid())
  organizationId String
  userId         String
  label          String
  sampleText     String
  provenance     VoiceSampleProvenance @default(PASTED)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@index([organizationId, userId, createdAt])
}

model MailboxConnection {
  id                    String                  @id @default(cuid())
  organizationId        String
  userId                String
  provider              MailboxProvider
  status                MailboxConnectionStatus @default(CONNECTED)
  mailboxAddress        String
  providerTenantId      String?
  providerAccountId     String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  grantedScopesJson     Json
  lastErrorCode         String?
  connectedAt           DateTime                @default(now())
  refreshedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, status])
}

model MailboxOAuthState {
  id                    String          @id @default(cuid())
  organizationId        String
  userId                String
  provider              MailboxProvider
  stateHash             String          @unique
  nonceHash             String
  encryptedCodeVerifier String
  returnPath            String
  expiresAt             DateTime
  createdAt             DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model OrganizationMembership {
  id               String         @id @default(cuid())
  organizationId   String
  userId           String
  role             MembershipRole @default(MEMBER)
  isBillingContact Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationBillingProfile {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  billingEmail     String?
  companyLegalName String?
  taxId            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  postalCode       String?
  countryCode      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Organization-level usage limits. Defaults are DB-backed configuration, not product constants.
model OrganizationUsagePolicy {
  id                           String   @id @default(cuid())
  organizationId               String   @unique
  activeResearchedCompanyLimit Int
  dailyEmailGenerationLimit    Int
  dailyEmailSendWarningLimit   Int      @default(150)
  dailyEmailSendLimit          Int      @default(250)
  emailDeeplinkMaxUrlLength    Int      @default(1800)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Organization-level research depth / freshness. Editable; not hard-coded forever.
model ResearchPolicy {
  id                                 String   @id @default(cuid())
  organizationId                     String   @unique
  maxSearchQueriesPerCompany         Int
  maxSourcesPerCompany               Int
  researchFreshnessDays              Int
  /// Progressive contact-role research limits (criteria-aware; not hard-coded forever).
  maxSearchQueriesPerContact         Int      @default(2)
  maxSourcesPerContact               Int      @default(6)
  contactResearchFreshnessDays       Int      @default(90)
  /// Product URL/web source reacquisition freshness. Default written at create: 120.
  productSourceResearchFreshnessDays Int      @default(120)
  maxSearchQueriesPerProduct         Int      @default(3)
  maxSourcesPerProduct               Int      @default(12)
  maxSearchQueriesPerPersona         Int      @default(2)
  maxSourcesPerPersona               Int      @default(8)
  personaResearchFreshnessDays       Int      @default(90)
  /// Max criteria projected from Persona AI signal arrays before review cap.
  maxProjectedPersonaCriteria        Int      @default(15)
  /// Max TARGETED_SEARCH ICP criteria per ICP (enforce at save — never silently drop).
  maxTargetedSearchCriteriaPerIcp    Int      @default(3)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Optional per-user overrides. Null field = inherit OrganizationUsagePolicy.
model UserUsageOverride {
  id                           String   @id @default(cuid())
  organizationId               String
  userId                       String
  activeResearchedCompanyLimit Int?
  dailyEmailGenerationLimit    Int?
  dailyEmailSendWarningLimit   Int?
  dailyEmailSendLimit          Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// Immutable usage/telemetry events. Authoritative for metering; do not update/delete from app UX.
model UsageEvent {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  category       UsageCategory
  operation      UsageOperation
  provider       String?
  model          String?
  companyId      String?
  contactId      String?
  scoringRunId   String?
  campaignId     String?
  /// Links attempt/retry events for the same logical operation when used.
  operationId    String?
  inputTokens    Int?
  outputTokens   Int?
  webSearchCalls Int?
  status         UsageEventStatus
  retryCount     Int              @default(0)
  durationMs     Int?
  /// Safe structured metadata only — never API keys or secrets.
  metadata       Json?
  occurredAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, userId])
  @@index([organizationId, category])
  @@index([organizationId, operation])
  @@index([operationId])
  @@index([companyId])
  @@index([scoringRunId])
}

/// Concurrency-safe daily (or period) quota consumption ledger.
model UsageQuotaLedger {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  resource       UsageResource
  /// Calendar day (or period) key in the Organization timezone, e.g. 2026-08-20.
  periodKey      String
  consumed       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, resource, periodKey])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, resource, periodKey])
}

model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  role            MembershipRole   @default(MEMBER)
  /// SHA-256 hash of the raw invitation token. Never store the raw token.
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@index([email])
}

model Product {
  id                       String                @id @default(cuid())
  organizationId           String
  name                     String
  description              String?
  valueProposition         String?
  averageOrderValue        Decimal?              @db.Decimal(12, 2)
  websiteUrl               String?
  /// Assisted-setup approval. Downstream scoring uses APPROVED authoritative fields.
  approvalStatus           ProductApprovalStatus @default(NOT_STARTED)
  setupStatus              ProductSetupStatus    @default(NOT_STARTED)
  approvedAt               DateTime?
  approvedByUserId         String?
  approvedEvidenceBundleId String?
  approvedSetupRunId       String?
  /// Extended approved product profile (problems, capabilities, etc.).
  profileJson              Json?
  /// Approved product messaging guidance (not scoring evidence).
  messagingJson            Json?
  /// Field paths the user edited — protected from silent overwrite.
  manuallyEditedFields     Json?
  /// Soft-archive: hidden from setup UI; preserves ScoringRun FK history.
  archivedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  icps                   Icp[]
  personas               Persona[]
  campaigns              Campaign[]
  scoringRuns            ScoringRun[]
  titleSuggestions       TitleSuggestion[]
  titleDismissals        ProductTitleDismissal[]
  sources                ProductSource[]
  evidenceBundles        ProductEvidenceBundle[]
  setupRuns              ProductSetupRun[]
  personaSources         PersonaSource[]
  personaEvidenceBundles PersonaEvidenceBundle[]
  personaSetupRuns       PersonaSetupRun[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@index([organizationId, archivedAt])
}

model Offer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  primaryCta     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
}

model Icp {
  id                          String    @id @default(cuid())
  organizationId              String
  productId                   String
  name                        String
  description                 String?
  /// Authoritative natural-language ICP definition (preserved; never overwritten by AI).
  definition                  String?
  additionalContext           String?
  targetIndustries            Json?
  minEmployees                Int?
  maxEmployees                Int?
  minRevenue                  Decimal?  @db.Decimal(14, 2)
  maxRevenue                  Decimal?  @db.Decimal(14, 2)
  targetGeographies           Json?
  requiredTechnologies        Json?
  positiveSignals             Json?
  negativeSignals             Json?
  notes                       String?
  interpretationVersion       Int       @default(1)
  interpretationPromptVersion String?
  lastInterpretedAt           DateTime?
  /// Plain-language read-back of what interpretation understood (never overwrites definition).
  interpretationSummary       String?
  /// Explicitly named facts/constraints that could not be determined from the definition.
  interpretationUndetermined  String?
  /// Soft-archive: hidden from setup UI; preserves ScoringRun FK history.
  archivedAt                  DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  criteria     IcpCriterion[]
  campaigns    Campaign[]
  scoringRuns  ScoringRun[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@index([productId])
  @@index([organizationId, productId])
  @@index([organizationId, archivedAt])
}

/// Tenant-owned structured ICP criterion (AI-interpreted and/or manually edited).
model IcpCriterion {
  id                                String                  @id @default(cuid())
  organizationId                    String
  icpId                             String
  name                              String
  description                       String?
  criterionType                     String
  dataType                          CriterionDataType
  operator                          CriterionOperator
  targetValue                       Json?
  minValue                          Json?
  maxValue                          Json?
  allowedValues                     Json?
  importance                        CriterionImportance     @default(MEDIUM)
  isRequired                        Boolean                 @default(false)
  isDisqualifier                    Boolean                 @default(false)
  researchGuidance                  String?
  source                            CriterionSource         @default(AI_INTERPRETED)
  confidence                        ResearchConfidence?
  /// Where evidence is expected; app owns default (missing/unrecognized → TARGETED_SEARCH).
  evidenceClass                     CriterionEvidenceClass  @default(TARGETED_SEARCH)
  /// PRIMARY counts toward ICP fit; SECONDARY is an upside signal only.
  tier                              IcpCriterionTier        @default(PRIMARY)
  /// PRIMARY only. Confirmed failure disqualifies; unresolved is never a failure.
  isMandatory                       Boolean                 @default(false)
  /// When true, reinterpret preserves this evidenceClass even if the AI proposes another.
  evidenceClassLocked               Boolean                 @default(false)
  /// Required for TARGETED_SEARCH before the criterion is considered approved for scoring setup.
  targetedSearchDecision            TargetedSearchDecision?
  /// Fingerprint of name/description/type/class/operator/targets at approval time.
  /// Cleared (decision null) when the criterion changes materially.
  targetedSearchDecisionFingerprint String?
  targetedSearchDecidedAt           DateTime?
  /// When true, reinterpret must not overwrite this row without explicit user action.
  manuallyEdited                    Boolean                 @default(false)
  sortOrder                         Int                     @default(0)
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  icp          Icp          @relation(fields: [icpId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([icpId])
  @@index([organizationId, icpId])
  @@index([organizationId, icpId, sortOrder])
  @@index([organizationId, icpId, evidenceClass])
  @@index([organizationId, icpId, tier])
}

model Persona {
  id                          String                @id @default(cuid())
  organizationId              String
  productId                   String
  name                        String
  /// Authoritative natural-language persona / buyer-role definition (preserved).
  definition                  String?
  additionalContext           String?
  targetTitles                Json?
  department                  String?
  seniority                   String?
  responsibilities            String?
  painPoints                  String?
  desiredOutcomes             String?
  messagingNotes              String?
  interpretationVersion       Int                   @default(1)
  interpretationPromptVersion String?
  lastInterpretedAt           DateTime?
  approvalStatus              ProductApprovalStatus @default(NOT_STARTED)
  approvedAt                  DateTime?
  approvedByUserId            String?
  approvedEvidenceBundleId    String?
  approvedSetupRunId          String?
  manuallyEditedFields        Json?
  /// Links to a suggested buyer role key from a product setup run (optional).
  suggestionKey               String?
  whyThisPersonaMatters       String?
  /// Persona-specific messaging (not scoring evidence).
  personaMessagingJson        Json?
  /// Extended approved persona profile from staged Persona synthesis.
  profileJson                 Json?
  setupStatus                 PersonaSetupStatus    @default(NOT_STARTED)
  approvedPersonaSetupRunId   String?
  /// Soft-archive: hidden from setup UI; preserves ScoringRun FK history.
  archivedAt                  DateTime?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  criteria     PersonaCriterion[]
  campaigns     Campaign[]
  campaignPersonas CampaignPersona[]
  scoringRuns   ScoringRun[]
  matchedScores ContactScore[] @relation("ContactScoreMatchedPersona")
  setupRuns     PersonaSetupRun[]
  sources      PersonaSource[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@index([productId])
  @@index([organizationId, productId])
  @@index([organizationId, archivedAt])
}

/// Tenant-owned product source material (URL, paste, upload, note).
model ProductSource {
  id                 String              @id @default(cuid())
  organizationId     String
  productId          String
  sourceType         ProductSourceType
  displayName        String
  originalUrl        String?
  normalizedUrlKey   String?
  filename           String?
  mimeType           String?
  byteSize           Int?
  acquisitionMethod  String
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  retrievedAt        DateTime?
  contentHash        String
  status             ProductSourceStatus @default(PENDING)
  errorSafe          String?
  extractedText      String?
  freshnessExpiresAt DateTime?
  metadataJson       Json?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  blob         ProductSourceBlob?

  @@unique([organizationId, productId, contentHash])
  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, productId])
  @@index([organizationId, contentHash])
  @@index([organizationId, normalizedUrlKey])
}

/// Durable binary storage for uploaded product materials (Postgres, not ephemeral disk).
model ProductSourceBlob {
  id             String   @id @default(cuid())
  organizationId String
  sourceId       String   @unique
  bytes          Bytes
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       ProductSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Versioned product evidence bundle — reusable acquisition asset.
model ProductEvidenceBundle {
  id                     String             @id @default(cuid())
  organizationId         String
  productId              String
  version                Int
  parentBundleId         String?
  correlationId          String
  status                 ProductSetupStatus @default(ACQUIRING)
  createdByUserId        String?
  createdAt              DateTime           @default(now())
  normalizedEvidenceJson Json?
  sourceIdsJson          Json
  urlResearchPerformed   Boolean            @default(false)
  webSearchQueriesUsed   Int                @default(0)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  setupRuns              ProductSetupRun[]
  personaEvidenceBundles PersonaEvidenceBundle[]
  personaSetupRuns       PersonaSetupRun[]

  @@unique([organizationId, productId, version])
  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, productId])
}

/// One Product synthesis workflow over an evidence bundle (Product draft + suggested buyer roles).
/// Historical runs may still contain personaDraftsJson from pre-split prompt versions.
model ProductSetupRun {
  id                     String             @id @default(cuid())
  organizationId         String
  productId              String
  evidenceBundleId       String
  correlationId          String
  status                 ProductSetupStatus @default(SYNTHESIZING)
  productDraftJson       Json?
  messagingDraftJson     Json?
  /// Lightweight SuggestedBuyerRole[] (legacy runs may hold fuller suggested persona cards).
  suggestedPersonasJson  Json?
  /// Legacy field — no longer written by Product synthesis v3+. Kept for history.
  personaDraftsJson      Json?
  synthesisPromptVersion String?
  aiProvider             String?
  aiModel                String?
  errorSafe              String?
  createdByUserId        String?
  createdAt              DateTime           @default(now())
  completedAt            DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidenceBundle ProductEvidenceBundle @relation(fields: [evidenceBundleId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@index([evidenceBundleId])
  @@index([correlationId])
}

/// Persona-specific research source (not ProductSource).
model PersonaSource {
  id                 String              @id @default(cuid())
  organizationId     String
  productId          String
  personaSetupRunId  String?
  personaId          String?
  sourceType         ProductSourceType
  displayName        String
  originalUrl        String?
  normalizedUrlKey   String?
  filename           String?
  mimeType           String?
  byteSize           Int?
  acquisitionMethod  String
  /// CUSTOMER_EVIDENCE | WEB_EVIDENCE | MODEL_INFERENCE (input material class).
  provenanceClass    String              @default("WEB_EVIDENCE")
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  retrievedAt        DateTime?
  contentHash        String
  status             ProductSourceStatus @default(PENDING)
  errorSafe          String?
  extractedText      String?
  freshnessExpiresAt DateTime?
  metadataJson       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  persona      Persona?     @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([organizationId, contentHash])
  @@index([organizationId])
  @@index([productId])
  @@index([personaId])
  @@index([personaSetupRunId])
  @@index([organizationId, normalizedUrlKey])
}

/// Compact persona research evidence for one Persona setup attempt.
model PersonaEvidenceBundle {
  id                      String             @id @default(cuid())
  organizationId          String
  productId               String
  personaSetupRunId       String?
  version                 Int
  correlationId           String
  status                  PersonaSetupStatus @default(RESEARCHING)
  createdByUserId         String?
  createdAt               DateTime           @default(now())
  normalizedEvidenceJson  Json?
  sourceIdsJson           Json?
  productEvidenceBundleId String?
  webSearchQueriesUsed    Int                @default(0)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productEvidenceBundle ProductEvidenceBundle? @relation(fields: [productEvidenceBundleId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([correlationId])
}

/// One Persona research + synthesis run for a single buyer role.
model PersonaSetupRun {
  id                      String             @id @default(cuid())
  organizationId          String
  productId               String
  personaId               String?
  productEvidenceBundleId String
  personaEvidenceBundleId String?
  correlationId           String
  status                  PersonaSetupStatus @default(SYNTHESIZING)
  selectedBuyerRoleJson   Json?
  suggestionKey           String?
  userContextJson         Json?
  personaDraftJson        Json?
  synthesisPromptVersion  String?
  aiProvider              String?
  aiModel                 String?
  errorSafe               String?
  createdByUserId         String?
  createdAt               DateTime           @default(now())
  completedAt             DateTime?

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product               Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  persona               Persona?              @relation(fields: [personaId], references: [id], onDelete: SetNull)
  productEvidenceBundle ProductEvidenceBundle @relation(fields: [productEvidenceBundleId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@index([personaId])
  @@index([correlationId])
}

/// Tenant-owned structured Persona criterion (role/responsibility oriented).
model PersonaCriterion {
  id                   String                @id @default(cuid())
  organizationId       String
  personaId            String
  name                 String
  description          String?
  criterionType        String
  dataType             CriterionDataType
  operator             CriterionOperator
  targetValue          Json?
  minValue             Json?
  maxValue             Json?
  allowedValues        Json?
  importance           CriterionImportance   @default(MEDIUM)
  isRequired           Boolean               @default(false)
  isDisqualifier       Boolean               @default(false)
  /// TITLE_TESTABLE | EVIDENCE_TESTABLE for exclusions; null for non-disqualifiers.
  exclusionTestability ExclusionTestability?
  researchGuidance     String?
  source               CriterionSource       @default(AI_INTERPRETED)
  confidence           ResearchConfidence?
  manuallyEdited       Boolean               @default(false)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  persona      Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([personaId])
  @@index([organizationId, personaId])
  @@index([organizationId, personaId, sortOrder])
}

model ContactList {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  sourceType       ContactListSource @default(UPLOAD)
  originalFilename String?
  totalContacts    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  scoringRuns  ScoringRun[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, sourceType])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  contactListId  String
  companyId      String?
  firstName      String?
  lastName       String?
  email          String?
  title          String?
  company        String?
  companyWebsite String?
  industry       String?
  employeeCount  Int?
  revenue        Decimal? @db.Decimal(14, 2)
  location       String?
  linkedinUrl    String?
  phone          String?
  rawData        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactList      ContactList       @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  companyRecord    Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  scores           ContactScore[]
  campaignContacts CampaignContact[]
  contactResearch  ContactResearch[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, contactListId])
  @@index([contactListId])
  @@index([companyId])
  @@index([organizationId, companyId])
}

model Company {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  normalizedName   String
  website          String?
  normalizedDomain String?
  industry         String?
  employeeCount    Int?
  revenue          Decimal? @db.Decimal(14, 2)
  location         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  research     CompanyResearch[]

  @@unique([organizationId, normalizedDomain])
  @@index([organizationId])
  @@index([organizationId, normalizedName])
  @@index([organizationId, normalizedDomain])
}

model CompanyResearch {
  id                   String                @id @default(cuid())
  organizationId       String
  companyId            String
  status               CompanyResearchStatus @default(NOT_STARTED)
  researchMethod       ResearchMethod        @default(AUTOMATED)
  companySummary       String?
  whatTheySell         String?
  customerTypes        Json?
  primaryMarkets       Json?
  businessModel        String?
  estimatedAov         String?
  aovReasoning         String?
  companySizeContext   String?
  relevantTechnologies Json?
  buyingSignals        Json?
  riskSignals          Json?
  researchConfidence   ResearchConfidence?
  sourceCount          Int                   @default(0)
  researchSources      Json?
  researchedAt         DateTime?
  expiresAt            DateTime?
  /// Automated research provenance — never stores API keys.
  aiProvider           String?
  aiModel              String?
  aiModelUrlIdentifier String?
  promptVersion        String?
  /// Safe usage metadata from research provider (no pricing calculation).
  inputTokens          Int?
  outputTokens         Int?
  webSearchCallCount   Int?
  researchDurationMs   Int?
  /// User who initiated this research run (metering). Ownership remains Organization.
  researchedByUserId   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  researchedBy User?        @relation("ResearchInitiatedBy", fields: [researchedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([companyId])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@index([researchedByUserId])
}

/// Contact-level role research (separate from CompanyResearch). Answers "what are they responsible for?"
model ContactResearch {
  id                   String                @id @default(cuid())
  organizationId       String
  contactId            String
  status               ContactResearchStatus @default(NOT_STARTED)
  researchMethod       ResearchMethod        @default(AUTOMATED)
  confidence           ResearchConfidence?
  currentTitle         String?
  roleSummary          String?
  responsibilities     Json?
  ownershipAreas       Json?
  professionalSignals  Json?
  negativeRoleSignals  Json?
  researchSources      Json?
  researchedAt         DateTime?
  expiresAt            DateTime?
  aiProvider           String?
  aiModel              String?
  aiModelUrlIdentifier String?
  promptVersion        String?
  inputTokens          Int?
  outputTokens         Int?
  webSearchCallCount   Int?
  researchDurationMs   Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organizationId, contactId])
  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, status])
  @@index([expiresAt])
}

model ScoringRun {
  id              String           @id @default(cuid())
  organizationId  String
  contactListId   String
  productId       String
  icpId           String
  /// Null means the run scores against every product persona (see personaSnapshots).
  personaId       String?
  status          ScoringRunStatus @default(PENDING)
  totalContacts   Int              @default(0)
  scoredContacts  Int              @default(0)
  productSnapshot Json
  icpSnapshot     Json
  /// Single-persona audit snapshot. All-persona runs still store the first snapshot here.
  personaSnapshot Json
  /// Snapshots for every persona in the run. Length 1 for a single-persona run.
  personaSnapshots Json            @default("[]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  completedAt     DateTime?

  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactList            ContactList                   @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  product                Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  icp                    Icp                           @relation(fields: [icpId], references: [id], onDelete: Restrict)
  persona                Persona?                      @relation(fields: [personaId], references: [id], onDelete: Restrict)
  scores                 ContactScore[]
  qualificationOverrides QualificationBucketOverride[]
  titleSuggestions       TitleSuggestion[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([contactListId])
  @@index([organizationId, contactListId])
  @@index([productId])
  @@index([icpId])
  @@index([personaId])
}

/// Distinct unmatched job titles from an all-personas scoring run, with an optional AI proposal.
model TitleSuggestion {
  id                  String                 @id @default(cuid())
  organizationId      String
  scoringRunId        String
  productId           String
  unmatchedTitle      String
  normalizedTitle     String
  contactCount        Int
  proposedPersonaId   String?
  proposedPersonaName String?
  confidence          String?
  reasoning           String?
  status              TitleSuggestionStatus  @default(PENDING)
  resolvedPersonaId   String?
  resolvedAt          DateTime?
  resolvedById        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoringRun   ScoringRun   @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  resolvedBy   User?        @relation("TitleSuggestionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([scoringRunId, normalizedTitle])
  @@index([organizationId])
  @@index([organizationId, scoringRunId])
  @@index([organizationId, productId, status])
  @@index([productId])
}

/// Product-level dismissed titles so the same unmatched title is not re-proposed.
model ProductTitleDismissal {
  id              String   @id @default(cuid())
  organizationId  String
  productId       String
  normalizedTitle String
  unmatchedTitle  String
  dismissedById   String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  dismissedBy  User?        @relation("ProductTitleDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, productId, normalizedTitle])
  @@index([organizationId])
  @@index([productId])
}

model ContactScore {
  id                    String               @id @default(cuid())
  organizationId        String
  contactId             String
  scoringRunId          String
  scoringStatus         ContactScoringStatus @default(PENDING)
  overallScore          Int?
  icpScore              Int?
  personaScore          Int?
  companyScore          Int?
  productRelevanceScore Int?
  scoreLabel            ScoreLabel?
  companySummary        String?
  whatTheySell          String?
  estimatedAov          String?
  aovReasoning          String?
  fitStrengths          Json?
  fitRisks              Json?
  disqualifiers         Json?
  reasoning             String?
  recommendedAction     String?
  researchStatus        ResearchStatus       @default(NOT_STARTED)
  researchSources       Json?
  researchedAt          DateTime?
  /// Provenance: which CompanyResearch version informed this score.
  companyResearchId     String?
  companyResearchAt     DateTime?
  /// Provenance: which ContactResearch version informed this score.
  contactResearchId     String?
  contactResearchAt     DateTime?
  /// Dynamic per-criterion assessments (auditability for criteria-driven scoring).
  criterionAssessments  Json?
  /// Validated structured assessment used to calculate scores (auditability).
  assessmentData        Json?
  aiProvider            String?
  aiModel               String?
  /// Sanitized model endpoint identifier — never includes API keys or credentials.
  aiModelUrlIdentifier  String?
  promptVersion         String?
  scoringLogicVersion   String?
  scoredAt              DateTime?
  scoringError          String?
  /// Best-matching persona for this contact when the run covers several personas.
  matchedPersonaId      String?
  matchedPersonaSnapshot Json?
  /// Per-persona gate + score outcomes for audit (one ContactScore row per contact).
  personaAssessments    Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  scoringRun     ScoringRun   @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  matchedPersona Persona?     @relation("ContactScoreMatchedPersona", fields: [matchedPersonaId], references: [id], onDelete: SetNull)

  @@unique([scoringRunId, contactId])
  @@index([organizationId])
  @@index([organizationId, contactId])
  @@index([contactId])
  @@index([scoringRunId])
  @@index([organizationId, scoringRunId])
  @@index([organizationId, scoreLabel])
  @@index([organizationId, researchStatus])
  @@index([organizationId, scoringStatus])
  @@index([matchedPersonaId])
}

model QualificationBucketOverride {
  id             String                      @id @default(cuid())
  organizationId String
  scoringRunId   String
  targetType     QualificationOverrideTarget
  targetId       String
  bucket         QualificationBucket
  overriddenById String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoringRun   ScoringRun   @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  overriddenBy User         @relation(fields: [overriddenById], references: [id], onDelete: Restrict)

  @@unique([organizationId, scoringRunId, targetType, targetId])
  @@index([organizationId])
  @@index([scoringRunId])
  @@index([overriddenById])
}

model Campaign {
  id                            String         @id @default(cuid())
  organizationId                String
  name                          String
  productId                     String
  icpId                         String
  personaId                     String?
  /// Legacy optional link to Offer table. New campaigns use offer* fields below.
  offerId                       String?
  offerName                     String?
  offerDescription              String?
  offerCta                      String?
  offerNotes                    String?
  offerValidationJson           Json?
  offerValidationHash           String?
  offerConflictAcknowledgedHash String?
  offerConflictAcknowledgedAt   DateTime?
  emailLength                   EmailLength    @default(MEDIUM)
  emailGuidance                 String?
  status                        CampaignStatus @default(DRAFT)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id])
  icp          Icp               @relation(fields: [icpId], references: [id])
  persona      Persona?          @relation(fields: [personaId], references: [id])
  offer        Offer?            @relation(fields: [offerId], references: [id])
  contacts     CampaignContact[]
  personasInPlay CampaignPersona[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([productId])
  @@index([icpId])
  @@index([personaId])
  @@index([offerId])
}

/// Personas a campaign will email. Empty means all personas for the product.
/// Campaign.personaId remains as a legacy single-persona fallback.
model CampaignPersona {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  personaId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  persona      Persona      @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@unique([organizationId, campaignId, personaId])
  @@index([organizationId])
  @@index([campaignId])
  @@index([personaId])
}

model CampaignContact {
  id             String                @id @default(cuid())
  organizationId String
  campaignId     String
  contactId      String
  selected       Boolean               @default(true)
  status         CampaignContactStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  emailDrafts  EmailDraft[]
  sendRecords  EmailSendRecord[]

  @@unique([organizationId, campaignId, contactId])
  @@index([organizationId])
  @@index([organizationId, campaignId])
  @@index([campaignId])
  @@index([contactId])
}

model EmailDraft {
  id                   String               @id @default(cuid())
  organizationId       String
  campaignContactId    String
  sequenceNumber       Int
  subject              String?
  body                 String?
  generatedBody        String?
  status               EmailDraftStatus     @default(NOT_CREATED)
  source               EmailDraftSource     @default(AI)
  kind                 EmailDraftKind       @default(INITIAL)
  replyClassification  ReplyClassification?
  prospectReplyText    String?
  referralSuggested    Boolean              @default(false)
  inReplyToDraftId     String?
  emailLength          EmailLength?
  personaId            String?
  personalizationTier  String?
  personalizationSources String?
  approvedAt           DateTime?
  sentAt               DateTime?
  sentMethod           EmailSentMethod?
  sentByUserId         String?
  sendAttemptId        String?
  sendAttemptStartedAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact   @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  inReplyTo       EmailDraft?       @relation("EmailDraftReplies", fields: [inReplyToDraftId], references: [id], onDelete: SetNull)
  replyDrafts     EmailDraft[]      @relation("EmailDraftReplies")
  sentByUser      User?             @relation("EmailDraftSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  sendRecords     EmailSendRecord[]

  @@unique([organizationId, campaignContactId, sequenceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([campaignContactId])
  @@index([inReplyToDraftId])
  @@index([sentByUserId])
  @@index([status])
}

model EmailSendRecord {
  id                String                @id @default(cuid())
  organizationId    String
  emailDraftId      String
  campaignContactId String
  recipient         String
  subject           String
  generatedBody     String
  finalBody         String
  sentByUserId      String
  method            EmailSendRecordMethod
  occurredAt        DateTime              @default(now())
  providerMessageId String?
  providerRequestId String?
  createdAt         DateTime              @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailDraft      EmailDraft      @relation(fields: [emailDraftId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  sentByUser      User            @relation(fields: [sentByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, sentByUserId, occurredAt])
  @@index([emailDraftId])
  @@index([campaignContactId])
  @@index([providerMessageId])
}

model AuthUser {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  firstName     String        @default("")
  lastName      String        @default("")
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@unique([email])
  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  /// Better Auth 1.7+ account identity scope (e.g. local:credential).
  issuer                String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

model AdminAuditEvent {
  id             String           @id @default(cuid())
  action         AdminAuditAction
  actorUserId    String?
  organizationId String?
  targetUserId   String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorUserId])
  @@index([organizationId])
  @@index([createdAt])
}

model TransactionalEmailTemplate {
  id              String                        @id @default(cuid())
  templateKey     TransactionalEmailTemplateKey @unique
  displayName     String
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String
  enabled         Boolean                       @default(true)
  version         Int                           @default(1)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
}

model TransactionalEmailTemplateBaseline {
  id              String                        @id @default(cuid())
  templateKey     TransactionalEmailTemplateKey @unique
  displayName     String
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String
  createdAt       DateTime                      @default(now())
}

model TransactionalEmailEvent {
  id                       String                        @id @default(cuid())
  userId                   String?
  organizationId           String?
  templateKey              TransactionalEmailTemplateKey
  templateVersion          Int?
  recipientEmailNormalized String
  provider                 String
  providerMessageId        String?
  status                   TransactionalEmailStatus
  failureCategory          String?
  retryCount               Int                           @default(0)
  idempotencyKey           String?
  createdAt                DateTime                      @default(now())
  sentAt                   DateTime?

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([templateKey])
  @@index([recipientEmailNormalized])
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([bucketKey, windowStart])
  @@index([bucketKey])
}
