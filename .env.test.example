# Local/CI test database only. Never point this at Render.
# Used by `npm test` and `npm run db:test:migrate`.
# Copy to `.env.test` if you need to override (`.env.test` is gitignored).

TEST_DATABASE_URL="postgresql://email_platform_test:email_platform_test@127.0.0.1:5433/email_platform_test?schema=public"

# Prisma reads DATABASE_URL. Tests copy TEST_DATABASE_URL onto DATABASE_URL.
# Do not set DATABASE_URL here to a production host.

# Optional: never set this against customer data.
# ALLOW_PROD_DB_TESTS=1
